# Hasła do bazy — przy pierwszej inicjalizacji trafiają do MySQL.
# PMA_PASSWORD musi być identyczne z MYSQL_ROOT_PASSWORD (PMA loguje się jako root).
MYSQL_ROOT_PASSWORD=zmien-mnie
MYSQL_DATABASE=budowlanka_rezerwacje
MYSQL_USER=app
MYSQL_PASSWORD=zmien-mnie

PMA_USER=root
PMA_PASSWORD=zmien-mnie

# prod = cookie_secure po HTTPS, linki absolutne z https://
APP_ENV=prod
APP_URL=https://owc.dziadu.dev

# Zaufane reverse proxy (IP kontenera cloudflared). Puste = tylko pętla lokalna.
TRUSTED_PROXY_IPS=

# Publikacja portów — 127.0.0.1 = tylko lokalnie, IP z Tailscale = dostęp w tailnecie
BIND_ADDR=127.0.0.1

# phpMyAdmin za tunelem wymaga jawnego URI z ukośnikiem na końcu
PMA_ABSOLUTE_URI=https://php.dziadu.dev/

# Tag obrazu — latest albo konkretny sha-xxxxxxxx
IMAGE_TAG=latest
