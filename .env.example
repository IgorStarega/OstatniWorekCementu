# Skopiuj: cp .env.example .env   (pliku .env nie commitujemy)
# Tylko dane deweloperskie do lokalnego Dockera — nie produkcja.

# --- Aplikacja (serwis app) ---
# local (domyślnie) albo prod (cookie_secure, tylko po HTTPS)
APP_ENV=local
# Publiczny adres bez końcowego "/" — źródło linków absolutnych.
# W prod wymagany i musi zaczynać się od https://
APP_URL=http://localhost:8082
# Zaufane reverse proxy, IP lub CIDR, po przecinku. Puste = tylko pętla lokalna.
TRUSTED_PROXY_IPS=

# --- Docker ---
# Interfejs publikacji portów (127.0.0.1 = tylko lokalnie)
BIND_ADDR=127.0.0.1

# --- MySQL: inicjalizacja serwera (serwis db) ---
# Z MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD compose wyprowadza DB_* dla aplikacji.
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=budowlanka_rezerwacje
MYSQL_USER=app
MYSQL_PASSWORD=app123

# --- phpMyAdmin (serwis phpmyadmin) ---
PMA_USER=root
PMA_PASSWORD=root123
