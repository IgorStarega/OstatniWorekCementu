# Przykładowa konfiguracja lokalna — SKOPIUJ do .env i dostosuj:
#   cp .env.example .env
# Plik .env jest w .gitignore (nie commituj go).
# To TYLKO dane deweloperskie do lokalnego Dockera, nie produkcja.

# --- Aplikacja ---
# Środowisko: local (domyślnie) albo prod (włącza cookie_secure dla sesji po HTTPS).
APP_ENV=local

# Publiczny adres aplikacji bez końcowego "/". Z niego (i tylko z niego) powstają
# linki absolutne przez helper absoluteUrl(). Lokalnie http://localhost:8082,
# a na serwerze (prod) jest wymagany i musi zaczynać się od https://.
APP_URL=http://localhost:8082

# Zaufane adresy reverse proxy (np. kontener cloudflared), rozdzielone przecinkami.
# Dopuszczalne pojedyncze IP oraz CIDR (np. 172.18.0.2, 172.18.0.0/16).
# Domyślnie PUSTE — nie ufamy całej prywatnej puli Dockera. Ustaw tylko wtedy,
# gdy origin jest nieosiągalny z zewnątrz (detekcja HTTPS z X-Forwarded-Proto).
TRUSTED_PROXY_IPS=

# --- Docker / publikacja portów ---
# Adres, na którym publikowane są porty (domyślnie tylko lokalnie).
BIND_ADDR=127.0.0.1

# Strefa czasowa kontenerów app i db.
TZ=Europe/Warsaw

# --- Baza danych: połączenie aplikacji (serwis app) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=budowlanka_rezerwacje
DB_USER=app
DB_PASS=app123

# --- Baza danych: inicjalizacja serwera MySQL (serwis db) ---
# Hasło roota MySQL (też do logowania w phpMyAdmin jako root).
MYSQL_ROOT_PASSWORD=root123

# Baza tworzona przy pierwszym starcie (tabele lądują w budowlanka_rezerwacje
# przez database/database.sql, więc trzymaj tu tę samą nazwę).
MYSQL_DATABASE=budowlanka_rezerwacje

# Użytkownik aplikacji w MySQL.
MYSQL_USER=app
MYSQL_PASSWORD=app123

# --- phpMyAdmin ---
PMA_HOST=db
PMA_PORT=3306
PMA_USER=root
PMA_PASSWORD=root123
PMA_ARBITRARY=1

# --- SMTP ---
# Relay SMTP do wysyłki maili (potwierdzenie e-mail, reset hasła).
# Puste = wysyłka wyłączona (tryb lokalny pokazuje link na ekranie).
# Ustaw dane dostawcy (np. Brevo/Mailgun/Resend/Postmark) tylko w lokalnym .env.
# SMTP_FROM to zweryfikowany nadawca, np. owc@dziadu.dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Ostatni Worek Cementu
