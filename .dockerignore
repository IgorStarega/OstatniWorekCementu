# Kontekst buildu — obraz zawiera kod aplikacji (app/, config/, public/).
# Do obrazu nie trafiają sekrety, dane bazy, dokumentacja ani pliki deweloperskie.

# Repozytorium, edytory, CI
.git/
.github/
.opencode/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Sekrety i konfiguracja lokalna
.env*
config/*.local.php
docker-compose*.yml

# Logi, kopie zapasowe, zależności
*.log
*.tmp
*.bak
*~
vendor/

# Duże/zbędne w obrazie: dane bazy, zrzuty SQL, docs, motyw PMA, uploady, grafiki
data/
database/
deploy/
docs/
themes/
tools/
public/uploads/
*.jpg
*.md
LICENSE
